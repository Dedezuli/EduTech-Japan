# Salin menjadi .env.local (lokal) atau isi di environment server (produksi).

# WAJIB di produksi. Gunakan password panjang & unik. Tanpa ini aplikasi menolak login admin saat NODE_ENV=production.
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Lokasi database. SQLite: path relatif terhadap folder prisma/.
# PostgreSQL/Supabase: postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"
